PORT=5000
NODE_ENV=development

# MongoDB Connection (choose one)

# Option 1: Local MongoDB (requires local MongoDB installation)
# MONGODB_URI=mongodb://localhost:27017/ai-tourist-guide

# Option 2: MongoDB Atlas (cloud - replace with your connection string)
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ai-tourist-guide?retryWrites=true&w=majority

# Option 3: Docker (recommended - use docker-compose up)
MONGODB_URI=mongodb://localhost:27017/ai-tourist-guide

JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key

MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
OPENWEATHER_API_KEY=your_openweather_api_key
GOOGLE_PLACES_API_KEY=your_google_places_key

FRONTEND_URL=http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

LOG_LEVEL=info
